<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- ADR-0001: las pruebas corren contra PostgreSQL, no contra SQLite en
             memoria. Las restricciones que protegen el stock y los correlativos
             son propias del motor, y probarlas contra otro daría confianza falsa.
             La base de pruebas es dedicada y se recrea en cada corrida. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <!-- DB_DATABASE no se declara acá a propósito. Este archivo está
             versionado, así que fijar el nombre obligaba a todos los worktrees a
             compartir una sola base de pruebas, y `RefreshDatabase` ejecuta
             `migrate:fresh`: dos suites simultáneas se destruían entre sí. El
             nombre lo calcula `tests/bootstrap.php` por árbol de trabajo,
             respetando la convención `ventas_inventario_<carril>_test`, y aborta
             si no puede. Exportar DB_DATABASE en el entorno sigue mandando sobre
             todo lo demás. -->
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
