# Copiar a .env y completar los valores marcados como requeridos — .env
# nunca se commitea, tiene que estar en .gitignore.

# Requerido. Se genera con `php artisan key:generate`.
APP_KEY=

# Opcional — default si no se define: ventas-inventario. No es sensible.
APP_NAME=ventas-inventario

# Opcional — default si no se define: production. En desarrollo: local.
APP_ENV=local

# Opcional — default si no se define: false. Nunca true en producción.
APP_DEBUG=true

# Opcional — default si no se define: http://localhost:8000
APP_URL=http://localhost:8000

# Opcional. Zona horaria de visualización. No cambia el almacenamiento, que
# siempre es UTC.
APP_TIMEZONE=America/Lima

# --- Base de datos (PostgreSQL, ver docs/decisiones/0001) ---

# Requerido. Sin esto la aplicación debe fallar al iniciar, no arrancar a medias.
DB_CONNECTION=pgsql

# Opcional — default si no se define: 127.0.0.1
DB_HOST=127.0.0.1

# Opcional — default si no se define: 5432
DB_PORT=5432

# Requerido.
DB_DATABASE=

# Requerido.
DB_USERNAME=

# Requerido, secreto — nunca un valor real acá.
DB_PASSWORD=

# --- Cola de envíos a SUNAT (ver docs/decisiones/0003) ---

# Requerido. `database` es suficiente para un solo local; nunca `sync` en
# producción, porque eso volvería el envío a SUNAT bloqueante.
QUEUE_CONNECTION=database

# --- SUNAT (ver docs/integraciones/sunat.md) ---

# Requerido. `beta` o `produccion`. Solo `beta` está autorizado sin aprobación
# explícita del dueño del negocio.
SUNAT_AMBIENTE=beta

# Requerido. RUC del emisor, 11 dígitos.
SUNAT_RUC=

# Requerido. Usuario secundario SOL.
SUNAT_USUARIO_SOL=

# Requerido, secreto — nunca un valor real acá.
SUNAT_CLAVE_SOL=

# Requerido. Ruta absoluta al archivo del certificado digital, fuera del
# repositorio.
SUNAT_CERTIFICADO_RUTA=

# Requerido, secreto — nunca un valor real acá.
SUNAT_CERTIFICADO_CLAVE=

# --- Reglas de negocio configurables ---

# Opcional — default si no se define: 700.00. Importe a partir del cual una
# boleta exige identificar al cliente. Ver docs/contratos/ventas.md.
VENTA_TOPE_BOLETA_SIN_DOCUMENTO=700.00

# Opcional — default si no se define: 30. Días de anticipación de la alerta de
# vencimiento de lotes.
INVENTARIO_DIAS_POR_VENCER=30
